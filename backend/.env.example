DATABASE_URL=postgresql://peblo_user:peblo_password@localhost:5432/peblo_db
JWT_SECRET=super_secret_for_development_only_123
DATA_DIR=data

# Production Secret Management Strategy
# In production, sensitive variables like JWT_SECRET and DATABASE_URL should not be stored in environment files or source control.
# Instead, they should be injected at runtime using a secure secrets manager (e.g., AWS Secrets Manager, HashiCorp Vault, or Google Secret Manager).
# For containerized environments (like ECS or Kubernetes), secrets can be securely passed as environment variables by the orchestrator at startup.
